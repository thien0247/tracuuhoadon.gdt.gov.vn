{
  "name": "gdt-tax-crawler-nextjs",
  "version": "4.0.0",
  "description": "Full-Stack Next.js App Router & TypeScript Gateway for GDT Tax Crawler & Search Engine",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:next": "next dev -p 3000",
    "start": "tsx src/server.ts",
    "start:next": "next start -p 8123 -H 0.0.0.0",
    "build": "next build",
    "build:ui": "next build",
    "check:types": "tsc --noEmit",
    "check:lines": "tsx tests/check_ts_line_limits.ts",
    "test:server": "tsx tests/test_ts_server.ts"
  },
  "keywords": [
    "tax-crawler",
    "gdt",
    "nextjs",
    "react",
    "fastify",
    "typescript",
    "postgresql",
    "ulid"
  ],
  "author": "VNPT Dak Lak & AI Assistant",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@tanstack/react-table": "^8.21.3",
    "exceljs": "^4.4.0",
    "fastify": "^4.26.2",
    "next": "^14.2.15",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
