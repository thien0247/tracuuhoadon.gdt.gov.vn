        private Panel CreateSpacer(int height)
        {
            Panel sp = new Panel();
            sp.Dock = DockStyle.Top;
            sp.Height = height;
            return sp;
        }

        // =====================================================================
        //  6. THEME ENGINE
        // =====================================================================
        private AppTheme GetLightTheme()
        {
            return new AppTheme
            {
                Name = "light",
                FormBg = Color.FromArgb(241, 245, 249),
                HeaderBg = Color.FromArgb(255, 255, 255),
                HeaderTitle = Color.FromArgb(15, 23, 42),
                HeaderSub = Color.FromArgb(100, 116, 139),
                CardBg = Color.FromArgb(255, 255, 255),
                CardBorder = Color.FromArgb(203, 213, 225),
                TextPrimary = Color.FromArgb(15, 23, 42),
                TextSecondary = Color.FromArgb(100, 116, 139),
                InputBg = Color.FromArgb(248, 250, 252),
                InputBorder = Color.FromArgb(203, 213, 225),
                InputText = Color.FromArgb(15, 23, 42),
                LogBg = Color.FromArgb(15, 23, 42),
                LogHeaderBg = Color.FromArgb(30, 41, 59),
                FooterBg = Color.FromArgb(241, 245, 249),
                FooterText = Color.FromArgb(100, 116, 139),
                SecondaryBtnBg = Color.FromArgb(226, 232, 240),
                SecondaryBtnHover = Color.FromArgb(203, 213, 225),
                SecondaryBtnText = Color.FromArgb(30, 41, 59)
            };
        }

        private AppTheme GetDarkTheme()
        {
            return new AppTheme
            {
                Name = "dark",
                FormBg = Color.FromArgb(19, 19, 22),
                HeaderBg = Color.FromArgb(24, 24, 29),
                HeaderTitle = Color.FromArgb(244, 244, 245),
                HeaderSub = Color.FromArgb(161, 161, 170),
                CardBg = Color.FromArgb(31, 31, 38),
                CardBorder = Color.FromArgb(45, 45, 56),
                TextPrimary = Color.FromArgb(244, 244, 245),
                TextSecondary = Color.FromArgb(161, 161, 170),
                InputBg = Color.FromArgb(19, 19, 22),
                InputBorder = Color.FromArgb(55, 65, 81),
                InputText = Color.FromArgb(244, 244, 245),
                LogBg = Color.FromArgb(13, 13, 17),
                LogHeaderBg = Color.FromArgb(26, 26, 32),
                FooterBg = Color.FromArgb(19, 19, 22),
                FooterText = Color.FromArgb(113, 113, 122),
                SecondaryBtnBg = Color.FromArgb(45, 45, 56),
                SecondaryBtnHover = Color.FromArgb(59, 59, 74),
                SecondaryBtnText = Color.FromArgb(244, 244, 245)
            };
        }

        private void ApplyTheme(string themeName)
        {
            currentThemeName = (themeName == "dark") ? "dark" : "light";
            currentTheme = (currentThemeName == "dark") ? GetDarkTheme() : GetLightTheme();

            this.BackColor = currentTheme.FormBg;
            this.ForeColor = currentTheme.TextPrimary;

            if (pnlHeader != null) pnlHeader.BackColor = currentTheme.HeaderBg;
            if (lblTitle != null) lblTitle.ForeColor = currentTheme.HeaderTitle;
            if (lblSub != null) lblSub.ForeColor = currentTheme.HeaderSub;

            if (btnThemeToggle != null)
            {
                if (currentThemeName == "dark")
                {
                    btnThemeToggle.Text = "☀️ Giao Diện Sáng";
                    btnThemeToggle.BackColor = Color.FromArgb(45, 45, 56);
                    btnThemeToggle.ForeColor = Color.FromArgb(244, 244, 245);
                    btnThemeToggle.FlatAppearance.MouseOverBackColor = Color.FromArgb(59, 59, 74);
                }
                else
                {
                    btnThemeToggle.Text = "🌙 Giao Diện Tối";
                    btnThemeToggle.BackColor = Color.FromArgb(226, 232, 240);
                    btnThemeToggle.ForeColor = Color.FromArgb(15, 23, 42);
                    btnThemeToggle.FlatAppearance.MouseOverBackColor = Color.FromArgb(203, 213, 225);
                }
            }

            if (pnlContent != null) pnlContent.BackColor = currentTheme.FormBg;
            if (pnlStatusCard != null) pnlStatusCard.BackColor = currentTheme.CardBg;
            if (lblStatusTag != null) lblStatusTag.ForeColor = currentTheme.TextSecondary;
            if (lblServiceInfo != null) lblServiceInfo.ForeColor = currentTheme.TextSecondary;
            if (lblPid != null) lblPid.ForeColor = currentTheme.TextSecondary;

            if (pnlActions != null) pnlActions.BackColor = currentTheme.CardBg;
            if (lblActionTitle != null) lblActionTitle.ForeColor = currentTheme.TextPrimary;

            if (pnlPort != null) pnlPort.BackColor = currentTheme.CardBg;
            if (lblPortTitle != null) lblPortTitle.ForeColor = currentTheme.TextPrimary;
            if (txtPort != null)
            {
                txtPort.BackColor = currentTheme.InputBg;
                txtPort.ForeColor = currentTheme.InputText;
            }

            if (pnlFooter != null) pnlFooter.BackColor = currentTheme.FooterBg;
            if (lblFooter != null) lblFooter.ForeColor = currentTheme.FooterText;

            if (pnlLogContainer != null) pnlLogContainer.BackColor = currentTheme.CardBg;
            if (pnlLogHeader != null) pnlLogHeader.BackColor = currentTheme.LogHeaderBg;
            if (lblLogTitle != null) lblLogTitle.ForeColor = (currentThemeName == "light") ? Color.FromArgb(226, 232, 240) : currentTheme.TextSecondary;
            if (btnClearLog != null)
            {
                btnClearLog.BackColor = (currentThemeName == "light") ? Color.FromArgb(51, 65, 85) : currentTheme.SecondaryBtnBg;
                btnClearLog.ForeColor = Color.FromArgb(244, 244, 245);
            }
            if (rtbLog != null) rtbLog.BackColor = currentTheme.LogBg;

            Color linkColor = (currentThemeName == "light") ? Color.FromArgb(2, 132, 199) : Color.FromArgb(56, 189, 248);
            if (lblUrl != null) lblUrl.ForeColor = linkColor;

            if (pnlStatusCard != null) pnlStatusCard.Invalidate();
            if (pnlActions != null) pnlActions.Invalidate();
            if (pnlPort != null) pnlPort.Invalidate();
            if (pnlLogContainer != null) pnlLogContainer.Invalidate();
        }

        private void ToggleTheme()
        {
            string nextTheme = (currentThemeName == "light") ? "dark" : "light";
            ApplyTheme(nextTheme);
            SaveTheme(nextTheme);
            Log(string.Format("Đã chuyển giao diện sang: {0}", (nextTheme == "light") ? "Sáng (Light)" : "Tối (Dark)"), "STATUS");
        }

        private void AttachCardPaint(Panel p)
        {
            if (p == null) return;
            p.Paint += delegate(object s, PaintEventArgs e) {
                if (currentTheme != null)
                {
                    using (Pen pen = new Pen(currentTheme.CardBorder, 1))
                    {
                        e.Graphics.DrawRectangle(pen, 0, 0, p.ClientSize.Width - 1, p.ClientSize.Height - 1);
                    }
                }
            };
        }

        private Button CreateButton(string text, Color bg, int width, int height)
        {
            Button btn = new Button();
            btn.Text = text;
            btn.BackColor = bg;
            btn.ForeColor = Color.White;
            btn.FlatStyle = FlatStyle.Flat;
            btn.FlatAppearance.BorderSize = 0;
            btn.Font = new Font("Segoe UI", 9f, FontStyle.Bold);
            btn.Size = new Size(width, height);
            btn.Cursor = Cursors.Hand;
            btn.FlatAppearance.MouseOverBackColor = ControlPaint.Light(bg, 0.15f);
            btn.FlatAppearance.MouseDownBackColor = ControlPaint.Dark(bg, 0.15f);
            return btn;
        }

        // =====================================================================
        //  7. ĐÈN LED TRẠNG THÁI GDI+ KHỬ RĂNG CƯA
        // =====================================================================
        private void LedPanel_Paint(object sender, PaintEventArgs e)
        {
            e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
            using (SolidBrush brush = new SolidBrush(currentLedColor))
            {
                e.Graphics.FillEllipse(brush, 2, 2, 20, 20);
            }
            using (Pen ringPen = new Pen(Color.FromArgb(70, currentLedColor), 2f))
            {
                e.Graphics.DrawEllipse(ringPen, 1, 1, 22, 22);
            }
        }

        private void SetLedColor(Color c)
        {
            currentLedColor = c;
            ledPanel.Invalidate();
        }

        // =====================================================================
        //  8. KHAY HỆ THỐNG VỚI ICON ĐỘNG
        // =====================================================================
        private void InitializeTrayIcon()
        {
            trayMenu = new ContextMenuStrip();
            trayMenu.Font = new Font("Segoe UI", 9f);

            ToolStripMenuItem mnuOpenBrowser = new ToolStripMenuItem("🌐 Mở Web Dashboard");
            mnuOpenBrowser.Font = new Font("Segoe UI", 9f, FontStyle.Bold);
            mnuOpenBrowser.Click += delegate { OpenBrowser(); };

            ToolStripMenuItem mnuOpenWorker = new ToolStripMenuItem("⚡ Mở Python Worker API");
            mnuOpenWorker.Click += delegate { OpenWorkerApi(); };

            ToolStripSeparator sep1 = new ToolStripSeparator();

            ToolStripMenuItem mnuStart = new ToolStripMenuItem("▶️ Start Dịch Vụ");
            mnuStart.Click += delegate { ActionStart(); };

            ToolStripMenuItem mnuStop = new ToolStripMenuItem("⏹️ Stop Dịch Vụ");
            mnuStop.Click += delegate { ActionStop(); };

            ToolStripMenuItem mnuRestart = new ToolStripMenuItem("🔄 Reset Dịch Vụ");
            mnuRestart.Click += delegate { ActionRestart(); };

            ToolStripSeparator sep2 = new ToolStripSeparator();

            ToolStripMenuItem mnuToggleTheme = new ToolStripMenuItem("🌓 Đổi Giao Diện (Sáng/Tối)");
            mnuToggleTheme.Click += delegate { ToggleTheme(); };

            ToolStripSeparator sep3 = new ToolStripSeparator();

            ToolStripMenuItem mnuRestore = new ToolStripMenuItem("📱 Mở Cửa Sổ");
            mnuRestore.Click += delegate { RestoreWindow(); };

            ToolStripMenuItem mnuExit = new ToolStripMenuItem("❌ Thoát Hoàn Toàn");
            mnuExit.Click += delegate { ExitApplication(); };

            trayMenu.Items.Add(mnuOpenBrowser);
            trayMenu.Items.Add(mnuOpenWorker);
            trayMenu.Items.Add(sep1);
            trayMenu.Items.Add(mnuStart);
            trayMenu.Items.Add(mnuStop);
            trayMenu.Items.Add(mnuRestart);
            trayMenu.Items.Add(sep2);
            trayMenu.Items.Add(mnuToggleTheme);
            trayMenu.Items.Add(sep3);
            trayMenu.Items.Add(mnuRestore);
            trayMenu.Items.Add(mnuExit);

            trayIcon = new NotifyIcon();
            trayIcon.Text = APP_TITLE;
            trayIcon.ContextMenuStrip = trayMenu;
            trayIcon.Visible = true;

            trayIcon.DoubleClick += delegate { RestoreWindow(); };
            UpdateTrayIcon(Color.FromArgb(113, 113, 122));
        }

        private void RestoreWindow()
        {
            this.Show();
            this.WindowState = FormWindowState.Normal;
            this.BringToFront();
            this.Activate();
        }

        private void ExitApplication()
        {
            if (trayIcon != null)
            {
                trayIcon.Visible = false;
                trayIcon.Dispose();
            }
            Application.Exit();
        }

        private void UpdateTrayIcon(Color color)
        {
            try
            {
                using (Bitmap bmp = new Bitmap(32, 32))
                {
                    using (Graphics g = Graphics.FromImage(bmp))
                    {
                        g.SmoothingMode = SmoothingMode.AntiAlias;
                        g.TextRenderingHint = TextRenderingHint.ClearTypeGridFit;
                        g.Clear(Color.Transparent);

                        using (SolidBrush brush = new SolidBrush(color))
                        {
                            g.FillEllipse(brush, 1, 1, 30, 30);
                        }

                        using (Pen pen = new Pen(Color.FromArgb(80, 255, 255, 255), 2))
                        {
                            g.DrawEllipse(pen, 2, 2, 28, 28);
                        }

                        using (Font f = new Font("Segoe UI", 14f, FontStyle.Bold, GraphicsUnit.Pixel))
                        {
                            TextRenderer.DrawText(g, "G", f, new Rectangle(0, 0, 32, 32),
                                Color.White, TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter);
                        }
                    }

                    IntPtr hIcon = bmp.GetHicon();
                    Icon newIcon = Icon.FromHandle(hIcon);

                    if (trayIcon != null) trayIcon.Icon = newIcon;
                    this.Icon = newIcon;

                    if (lastCreatedIcon != null)
                    {
                        DestroyIcon(lastCreatedIcon.Handle);
                        lastCreatedIcon.Dispose();
                    }
                    lastCreatedIcon = newIcon;
                }
            }
            catch { }
        }

        // =====================================================================
        //  9. HỆ THỐNG LOG ĐA LUỒNG AN TOÀN
        // =====================================================================
        public void Log(string message, string level)
        {
            if (rtbLog.InvokeRequired)
            {
                rtbLog.BeginInvoke(new Action<string, string>(Log), message, level);
                return;
            }

            string time = DateTime.Now.ToString("HH:mm:ss");
            string prefix = string.Format("[{0}] [{1}] ", time, level);

            Color color = (currentThemeName == "light") ? Color.FromArgb(226, 232, 240) : Color.FromArgb(244, 244, 245);
            if (level == "SUCCESS") color = Color.FromArgb(34, 197, 94);
            else if (level == "ERROR") color = Color.FromArgb(239, 68, 68);
            else if (level == "WARN") color = Color.FromArgb(245, 158, 11);
            else if (level == "STATUS") color = Color.FromArgb(6, 182, 212);

            rtbLog.SelectionStart = rtbLog.TextLength;
            rtbLog.SelectionLength = 0;
            rtbLog.SelectionColor = Color.FromArgb(148, 163, 184);
            rtbLog.AppendText(string.Format("[{0}] ", time));

            rtbLog.SelectionColor = color;
            rtbLog.AppendText(string.Format("[{0}] {1}\n", level, message));

            rtbLog.SelectionStart = rtbLog.TextLength;
            rtbLog.ScrollToCaret();
        }

        // =====================================================================
        //  10. KIỂM TRA TRẠNG THÁI HỆ THỐNG & PORT
        // =====================================================================
        private void UpdateServiceStatus()
        {
            ThreadPool.QueueUserWorkItem(delegate {
                int status = GetServiceStatus();
                int port = GetSavedPort();
                bool isPort8123 = CheckTcpPortListening(port);
                bool isPort8124 = CheckTcpPortListening(DEFAULT_WORKER_PORT);

                this.BeginInvoke(new Action(delegate {
                    if (status == 1) // Running
                    {
                        lblStatus.Text = "ĐANG CHẠY (RUNNING)";
                        lblStatus.ForeColor = Color.FromArgb(22, 163, 74);
                        SetLedColor(Color.FromArgb(34, 197, 94));
                        UpdateTrayIcon(Color.FromArgb(34, 197, 94));
                        btnStart.Enabled = false;
                        btnStop.Enabled = true;
                        btnRestart.Enabled = true;
                        btnHeroAction.BackColor = Color.FromArgb(22, 163, 74);
                    }
                    else if (status == 0) // Stopped
                    {
                        lblStatus.Text = "ĐÃ DỪNG (STOPPED)";
                        lblStatus.ForeColor = Color.FromArgb(220, 38, 38);
                        SetLedColor(Color.FromArgb(239, 68, 68));
                        UpdateTrayIcon(Color.FromArgb(239, 68, 68));
                        btnStart.Enabled = true;
                        btnStop.Enabled = false;
                        btnRestart.Enabled = false;
                        btnHeroAction.BackColor = Color.FromArgb(100, 116, 139);
                    }
                    else // Not Installed (-1)
                    {
                        lblStatus.Text = "CHƯA ĐĂNG KÝ (NOT INSTALLED)";
                        lblStatus.ForeColor = Color.FromArgb(148, 163, 184);
                        SetLedColor(Color.FromArgb(113, 113, 122));
                        UpdateTrayIcon(Color.FromArgb(113, 113, 122));
                        btnStart.Enabled = false;
                        btnStop.Enabled = false;
                        btnRestart.Enabled = false;
                        btnHeroAction.BackColor = Color.FromArgb(100, 116, 139);
                    }

                    // Cập nhật trạng thái Port
                    if (isPort8123)
                    {
                        lblPort8123Status.Text = string.Format("Port {0} (Dashboard): SẴN SÀNG ✓", port);
                        lblPort8123Status.ForeColor = Color.FromArgb(22, 163, 74);
                    }
                    else
                    {
                        lblPort8123Status.Text = string.Format("Port {0} (Dashboard): Chưa kết nối", port);
                        lblPort8123Status.ForeColor = Color.FromArgb(148, 163, 184);
                    }

                    if (isPort8124)
                    {
                        lblPort8124Status.Text = string.Format("Port {0} (Worker): SẴN SÀNG ✓", DEFAULT_WORKER_PORT);
                        lblPort8124Status.ForeColor = Color.FromArgb(22, 163, 74);
                    }
                    else
                    {
                        lblPort8124Status.Text = string.Format("Port {0} (Worker): Chưa kết nối", DEFAULT_WORKER_PORT);
                        lblPort8124Status.ForeColor = Color.FromArgb(148, 163, 184);
                    }

                    lblUrl.Text = string.Format("Dashboard: http://localhost:{0}", port);
                }));
            });
        }

        private int GetServiceStatus()
        {
            try
            {
                using (ServiceController sc = new ServiceController(SERVICE_NAME))
                {
                    if (sc.Status == ServiceControllerStatus.Running) return 1;
                    if (sc.Status == ServiceControllerStatus.Stopped) return 0;
                    return 2; // Transitioning
                }
            }
            catch
            {
                return -1; // Không tìm thấy service
            }
        }

        private bool CheckTcpPortListening(int port)
        {
            try
            {
                IPGlobalProperties props = IPGlobalProperties.GetIPGlobalProperties();
                IPEndPoint[] listeners = props.GetActiveTcpListeners();
                foreach (IPEndPoint ep in listeners)
                {
                    if (ep.Port == port) return true;
                }
            }
            catch { }
            return false;
        }

        // =====================================================================
        //  11. CÁC HÀNH ĐỘNG ĐIỀU KHIỂN (ACTIONS)
        // =====================================================================
        private void RunServiceBat(string arg, string actionLabel)
        {
            Log(string.Format("Đang thực hiện lệnh: {0} ({1})...", actionLabel, arg), "STATUS");
            ThreadPool.QueueUserWorkItem(delegate {
                try
                {
                    if (!File.Exists(serviceBatFile))
                    {
                        Log("Không tìm thấy tệp service.bat tại: " + serviceBatFile, "ERROR");
                        return;
                    }

                    ProcessStartInfo psi = new ProcessStartInfo();
                    psi.FileName = "cmd.exe";
                    psi.Arguments = string.Format("/c \"\"{0}\" {1}\"", serviceBatFile, arg);
                    psi.WorkingDirectory = projectRootDir;
                    psi.UseShellExecute = false;
                    psi.RedirectStandardOutput = true;
                    psi.RedirectStandardError = true;
                    psi.CreateNoWindow = true;

                    using (Process p = Process.Start(psi))
                    {
                        string output = p.StandardOutput.ReadToEnd();
                        string error = p.StandardError.ReadToEnd();
                        p.WaitForExit(15000);

                        if (!string.IsNullOrEmpty(output))
                        {
                            string[] lines = output.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                            foreach (string line in lines)
                            {
                                string l = line.Trim();
                                if (!string.IsNullOrEmpty(l) && !l.Contains("==") && !l.Contains("--"))
                                {
                                    Log(l, "INFO");
                                }
                            }
                        }

                        if (p.ExitCode == 0)
                        {
                            Log(string.Format("Hoàn tất lệnh: {0} thành công.", actionLabel), "SUCCESS");
                        }
                        else
                        {
                            Log(string.Format("Lệnh {0} kết thúc với mã {1}. {2}", actionLabel, p.ExitCode, error), "WARN");
                        }
                    }
                }
                catch (Exception ex)
                {
                    Log(string.Format("Lỗi thực thi {0}: {1}", actionLabel, ex.Message), "ERROR");
                }

                this.BeginInvoke(new Action(UpdateServiceStatus));
            });
        }

        private void ActionRegister()
        {
            RunServiceBat("register", "Đăng Ký Dịch Vụ");
        }

        private void ActionUnregister()
        {
            if (MessageBox.Show("Bạn có chắc chắn muốn gỡ bỏ dịch vụ " + SERVICE_NAME + " khỏi Windows?", 
                "Xác Nhận Gỡ Dịch Vụ", MessageBoxButtons.YesNo, MessageBoxIcon.Warning) == DialogResult.Yes)
            {
                RunServiceBat("uninstall", "Gỡ Dịch Vụ");
            }
        }

        private void ActionStart()
        {
            RunServiceBat("start", "Khởi Động Dịch Vụ");
        }

        private void ActionStop()
        {
            RunServiceBat("stop", "Dừng Dịch Vụ");
        }

        private void ActionRestart()
        {
            RunServiceBat("restart", "Khởi Động Lại Dịch Vụ");
        }

        private void ActionChangePort()
        {
            int p;
            if (int.TryParse(txtPort.Text.Trim(), out p) && p > 0 && p <= 65535)
            {
                SavePort(p);
                Log(string.Format("Đã lưu cổng Web mới: {0}", p), "SUCCESS");
                UpdateServiceStatus();
            }
            else
            {
                MessageBox.Show("Cổng không hợp lệ! Vui lòng nhập số từ 1 đến 65535.", "Cổng Không Hợp Lệ", 
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
        }

        private void OpenBrowser()
        {
            int port = GetSavedPort();
            string url = string.Format("http://localhost:{0}", port);
            Log("Mở trình duyệt: " + url, "STATUS");
            try { Process.Start(url); } catch { }
        }

        private void OpenWorkerApi()
        {
            string url = string.Format("http://localhost:{0}", DEFAULT_WORKER_PORT);
            Log("Mở API Worker: " + url, "STATUS");
            try { Process.Start(url); } catch { }
        }

        private void OpenLogsFolder()
        {
            try
            {
                if (!Directory.Exists(logsDir)) Directory.CreateDirectory(logsDir);
                Process.Start("explorer.exe", logsDir);
                Log("Đã mở thư mục logs: " + logsDir, "STATUS");
            }
            catch (Exception ex)
            {
                Log("Không thể mở thư mục logs: " + ex.Message, "ERROR");
            }
        }

        private void CheckAdminAndLog()
        {
            Log("Khởi động GDT Tax Crawler Service Manager...", "STATUS");
            if (IsAdministrator())
            {
                Log("Quyền Thực Thi: Administrator (Đầy đủ chức năng quản trị Service).", "SUCCESS");
            }
            else
            {
                Log("Lưu ý: Ứng dụng đang chạy ở quyền User thường. Cần Administrator để Start/Stop dịch vụ.", "WARN");
            }
        }

        private bool IsAdministrator()
        {
            try
            {
                WindowsIdentity id = WindowsIdentity.GetCurrent();
                WindowsPrincipal p = new WindowsPrincipal(id);
                return p.IsInRole(WindowsBuiltInRole.Administrator);
            }
            catch { return false; }
        }

        // =====================================================================
        //  12. CẤU HÌNH JSON (CONFIG.JSON)
        // =====================================================================
        private int GetSavedPort()
        {
            if (File.Exists(configFile))
            {
                try
                {
                    string txt = File.ReadAllText(configFile, Encoding.UTF8);
                    int idx = txt.IndexOf("\"port\":");
                    if (idx >= 0)
                    {
                        string sub = txt.Substring(idx + 7);
                        int end = sub.IndexOfAny(new[] { ',', '}', '\r', '\n' });
                        if (end > 0)
                        {
                            int p;
                            if (int.TryParse(sub.Substring(0, end).Trim(), out p)) return p;
                        }
                    }
                }
                catch { }
            }
            return DEFAULT_PORT;
        }

        private void SavePort(int port)
        {
            try
            {
                string json = string.Format("{{\n  \"port\": {0},\n  \"worker_port\": {1},\n  \"theme\": \"{2}\"\n}}", 
                    port, DEFAULT_WORKER_PORT, currentThemeName);
                File.WriteAllText(configFile, json, new UTF8Encoding(false));
            }
            catch { }
        }

        private string GetSavedTheme()
        {
            if (File.Exists(configFile))
            {
                try
                {
                    string txt = File.ReadAllText(configFile, Encoding.UTF8);
                    int idx = txt.IndexOf("\"theme\":");
                    if (idx >= 0)
                    {
                        string sub = txt.Substring(idx + 8);
                        int q1 = sub.IndexOf('"');
                        if (q1 >= 0)
                        {
                            int q2 = sub.IndexOf('"', q1 + 1);
                            if (q2 > q1)
                            {
                                string t = sub.Substring(q1 + 1, q2 - q1 - 1).Trim().ToLower();
                                if (t == "light" || t == "dark") return t;
                            }
                        }
                    }
                }
                catch { }
            }
            return "light";
        }

        private void SaveTheme(string theme)
        {
            try
            {
                int port = GetSavedPort();
                string json = string.Format("{{\n  \"port\": {0},\n  \"worker_port\": {1},\n  \"theme\": \"{2}\"\n}}", 
                    port, DEFAULT_WORKER_PORT, theme);
                File.WriteAllText(configFile, json, new UTF8Encoding(false));
            }
            catch { }
        }
    }
}
