using System.Windows.Forms;

namespace GDTTaxCrawlerManager
{
    static class Program
    {
        [STAThread]
        static void Main()
        {
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);
            Application.Run(new MainForm());
        }
    }

    public class MainForm : Form
    {
        [DllImport("user32.dll", CharSet = CharSet.Auto)]
        extern static bool DestroyIcon(IntPtr handle);

        // =====================================================================
        //  1. CẤU HÌNH DỰ ÁN
        // =====================================================================
        private const string APP_TITLE = "GDT Tax Crawler - Quản Lý Dịch Vụ & Máy Chủ";
        private const string APP_SUBTITLE = "Hệ thống Vét Cạn Mã Số Thuế & Tra Cứu Doanh Nghiệp (Fastify 8123 + Python 8124)";
        private const string SERVICE_NAME = "GDTTaxCrawler";
        private const int DEFAULT_PORT = 8123;
        private const int DEFAULT_WORKER_PORT = 8124;

        private string appDir;
        private string projectRootDir;
        private string configFile;
        private string serviceBatFile;
        private string logsDir;

        // =====================================================================
        //  2. THEME ENGINE (BẢNG MÀU SÁNG / TỐI)
