        // =====================================================================
        //  4. KHỞI TẠO FORM & VÒNG ĐỜI
        // =====================================================================
        public MainForm()
        {
            InitializePaths();
            currentThemeName = GetSavedTheme();
            currentTheme = (currentThemeName == "dark") ? GetDarkTheme() : GetLightTheme();

            InitializeComponent();
            InitializeTrayIcon();

            ApplyTheme(currentThemeName);

            CheckAdminAndLog();
            UpdateServiceStatus();

            statusTimer = new System.Windows.Forms.Timer();
            statusTimer.Interval = 2500;
            statusTimer.Tick += delegate { UpdateServiceStatus(); };
            statusTimer.Start();
        }

        private void InitializePaths()
        {
            appDir = AppDomain.CurrentDomain.BaseDirectory.TrimEnd('\\');
            // Thư mục gốc dự án (cha của service_gui_csharp hoặc chính nó)
            DirectoryInfo parent = Directory.GetParent(appDir);
            projectRootDir = (parent != null && File.Exists(Path.Combine(parent.FullName, "service.bat"))) 
                ? parent.FullName 
                : appDir;

            configFile = Path.Combine(appDir, "config.json");
            serviceBatFile = Path.Combine(projectRootDir, "service.bat");
            logsDir = Path.Combine(projectRootDir, "logs");
        }

